# Copy this file to .env and fill in real values. .env is gitignored.

# Required. API key for your OpenAI-compatible provider.
AI_API_KEY=

# Optional. Defaults to OpenAI's own API when unset.
# Point this at any OpenAI-compatible endpoint instead (Azure OpenAI, OpenRouter,
# a local model server, etc).
# AI_BASE_URL=https://api.openai.com/v1

# Required. Model name as understood by your provider, e.g. gpt-4o-mini for
# OpenAI, or whatever your compatible provider calls its model.
AI_MODEL=

# Optional. Defaults to logs/ai-usage.jsonl.
# Concise per-attempt usage and validation log.
# AI_LOG_PATH=logs/ai-usage.jsonl

# Optional. Defaults to logs/ai-full.jsonl.
# Full per-attempt API request/response log for debugging prompt behavior.
# AI_FULL_LOG_PATH=logs/ai-full.jsonl
